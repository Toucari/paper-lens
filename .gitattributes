# Normalise line endings to LF in the repository, regardless of platform.
# Without this, Windows clones commit CRLF and every file shows as modified
# for anyone on macOS/Linux.
* text=auto eol=lf

# Explicit for the types where a stray conversion breaks things.
*.md    text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Binary: never touch.
*.png   binary
*.jpg   binary
*.pdf   binary
*.zip   binary
